ANTHROPIC_API_KEY=sk-ant-your-key-here

# Optional but strongly recommended once deployed to cloud hosting —
# YouTube blocks most datacenter IPs. Without this, transcript fetches
# will likely fail in production even though they work locally.
WEBSHARE_PROXY_USERNAME=
WEBSHARE_PROXY_PASSWORD=

# Signs session cookies for accounts/login. Generate a random value
# (e.g. `python -c "import secrets; print(secrets.token_urlsafe(48))"`)
# and use the SAME value locally and in Railway.
JWT_SECRET=

# Optional locally (falls back to a local sqlite file, app/dev.db).
# Railway's Postgres plugin provides this automatically once added.
DATABASE_URL=

# Optional — enables video title/channel/views/comments/length on each
# summary. Get one from Google Cloud Console (enable "YouTube Data API
# v3", free tier: 10,000 units/day, 1 unit per summary). Without it,
# summaries still work, just without this extra metadata.
YOUTUBE_API_KEY=

# Optional — only needed if you set your account's AI Model preference
# to GPT or Gemini (Actions -> Preferences). Get an OpenAI key from
# platform.openai.com (pay-as-you-go billing) and/or a Gemini key from
# aistudio.google.com. Claude (the default) only needs ANTHROPIC_API_KEY.
OPENAI_API_KEY=
GEMINI_API_KEY=

# Required for the "Forgot password?" flow and the daily digest email
# to actually send. Sign up free at resend.com and create an API key —
# no domain verification needed, it sends from Resend's shared
# onboarding@resend.dev address at this volume.
RESEND_API_KEY=

# Optional locally (falls back to an in-memory rate limiter, reset on
# every restart). Railway's Redis plugin provides this automatically
# once added — makes the free-tier rate limit persist across restarts.
REDIS_URL=
